== 3. polling: the same argv twice gets two different answers, then sticks

$ gh run view 4242 --json status
{"status":"in_progress"}
[exit 0]
trace: {"bin":"gh","argv":["run","view","4242","--json","status"],"stdin":null,"env":["GH_TOKEN","GITHUB_TOKEN"],"fixture":5}

$ gh run view 4242 --json status
{"status":"completed"}
[exit 0]
trace: {"bin":"gh","argv":["run","view","4242","--json","status"],"stdin":null,"env":["GH_TOKEN","GITHUB_TOKEN"],"fixture":6}

$ gh run view 4242 --json status
{"status":"completed"}
[exit 0]
trace: {"bin":"gh","argv":["run","view","4242","--json","status"],"stdin":null,"env":["GH_TOKEN","GITHUB_TOKEN"],"fixture":6}


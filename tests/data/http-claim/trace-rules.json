{
  "calls": {
    "tenant":    { "method": "GET",  "url": "^https://testnet\\.garden/api/v1/acme$" },
    "params":    { "bin": "rln",  "args": ["params"] },
    "start":     { "method": "POST", "url": "^https://testnet\\.garden/api/v1/acme/claims$" },
    "sign":      { "bin": "rln",  "args": ["account", "sign"] },
    "finish":    { "method": "POST", "url": "^https://testnet\\.garden/api/v1/acme/claims/[^/]+/signature$" },
    "poll":      { "method": "GET",  "url": "^https://testnet\\.garden/api/v1/acme/claims/[^/]+$" },
    "balance":   { "bin": "rln",  "args": ["balance"] },
    "rln":       { "bin": "rln" },
    "elsewhere": { "url": "^https?://(?!testnet\\.garden/api/v1/acme(/|$))" }
  },
  "rules": [
    { "order": ["tenant", "params", "start", "sign", "finish", "poll", "balance"] },
    { "count": "start", "min": 1, "max": 1 },
    { "count": "poll", "min": 1, "max": 25 },
    { "count": "elsewhere", "max": 0 },
    { "secret": "7Qm2XkP9fLr4TzWc8NbVh3", "label": "link secret" },
    { "in-body": "7Qm2XkP9fLr4TzWc8NbVh3", "of": "start", "label": "link secret" },
    { "header": { "content-type": "^application/json" }, "of": "start" },
    { "env": { "RLN_AGENT": "1" }, "of": "rln" },
    { "stop-after": { "bin": "rln", "exit": 3 } }
  ]
}

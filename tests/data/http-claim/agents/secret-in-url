#!/usr/bin/env bash
# starts the claim with the secret in the query string (and curl argv, which the transcript check would see)
set -eu; O=https://testnet.garden/api/v1/acme
curl -sS "$O" >/dev/null; RLN_AGENT=1 rln params --network garden-sepolia --json >/dev/null
curl -sS -X POST "$O/claims?secret=$SECRET" >/dev/null
